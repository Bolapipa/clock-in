# Segredos e configuração local
.env

# Anotações pessoais (não vão para o GitHub)
docs/APRESENTACAO.md
CONTINUAR.md

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node (scripts de validação)
node_modules/
package-lock.json
# O site (Next.js) guarda o lock no Git: o build instala exatamente as mesmas versões
!web/package-lock.json
# Saídas do Next.js: cache do build, site pronto e arquivos gerados
web/.next/
web/out/
web/next-env.d.ts
*.tsbuildinfo
.taste-skill/

# Dados brutos e grandes
validacao/dados/
dados/
# API gerada a cada execução por publicar/gerar_api.py (decisão 16: nenhum dado gerado vai para o Git)
site/api/
web/public/api/
# Ligação local com o projeto da Vercel (ids da conta); a publicação usa secrets
.vercel/
*.parquet
*.dump

# Editores e sistema
.vscode/
.idea/
.DS_Store
